# ---------------------------------------------------------------------------
# Jira 8.14 (Server/DC)
# ---------------------------------------------------------------------------
JIRA_URL=https://jira.empresa.local
# Personal Access Token. PATs existem a partir da 8.14; gere em
# Perfil -> Personal Access Tokens. Use uma conta de serviço somente leitura.
JIRA_PAT=cole-o-token-aqui
# OBRIGATÓRIO e não vazio. Vazio ABORTA a execução: indexar tudo por padrão
# achataria o controle de acesso dos projetos restritos.
JIRA_PROJECTS=OPS,INFRA,SUP

# ---------------------------------------------------------------------------
# Confluence 4.2.4
# ---------------------------------------------------------------------------
CONFLUENCE_URL=https://wiki.empresa.local
# Esta versão NÃO suporta Personal Access Token: é usuário e senha.
# A Remote API (XML-RPC) precisa estar habilitada em
# Administração -> Configuração Geral -> Remote API (XML-RPC & SOAP).
CONFLUENCE_USER=svc-indexador
CONFLUENCE_PASSWORD=troque-isto
# OBRIGATÓRIO e não vazio. Vazio ABORTA a execução. Não inclua espaços
# restritos (RH, jurídico, financeiro): tudo que entra aqui fica visível
# para qualquer pessoa que consulte o MCP.
# Escopo do Confluence. Duas formas:
#
#   lista fixa   CONFLUENCE_SPACES=manuaisLavendere,desenvolvimento,suporte
# Espacos que nunca entram, mesmo visiveis.
#CONFLUENCE_EXCLUDE_SPACES=rh,juridico
#   por grupo    CONFLUENCE_SPACES=auto
#
# Com "auto" o escopo passa a ser o que o getSpaces() devolve, ou seja
# exatamente os espacos que o USUARIO DE SERVICO enxerga - o Confluence ja
# aplicou as permissoes de grupo dele. Para liberar mais espacos, adicione o
# grupo ao usuario NO CONFLUENCE; a proxima rodada os traz sozinha. Para tirar,
# remova o grupo: o conteudo daquele espaco sai do store e do indice.
#
# Nao existe API em 4.2.4 para perguntar "quais espacos o grupo X enxerga"
# (getSpacePermissionSet nao existe nesta versao, nem para administrador), por
# isso o escopo vem do usuario e nao do grupo diretamente.
#
# Medido: o usuario timedesenv enxerga 716 espacos, o wmw-rag enxerga 30.
# CONFIRA com `python -m indexer.sync scope` ANTES de rodar o extract.
CONFLUENCE_SPACES=INFRA,SUP,ARQ
# full_scan é a única estratégia implementada na Fase 1.
CONFLUENCE_INCREMENTAL_STRATEGY=full_scan
# getPages de um espaço grande é uma única chamada devolvendo milhares de
# resumos: medido em 181 s para 6.129 páginas. Não abaixe sem medir.
CONFLUENCE_TIMEOUT=300

# ---------------------------------------------------------------------------
# Índice e store
# ---------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=atlassian_kb
STORE_PATH=./data/documents.sqlite3

# ---------------------------------------------------------------------------
# Modelo BM25
# ---------------------------------------------------------------------------
# O runtime é offline por padrão e NUNCA baixa nada sozinho: se o artefato
# faltar, ele aborta explicando como pré-cacheá-lo.
FASTEMBED_CACHE_DIR=./models/fastembed
ALLOW_MODEL_DOWNLOAD=0

# ---------------------------------------------------------------------------
# Rede
# ---------------------------------------------------------------------------
# Ponha 0 apenas se as instâncias usam certificado autoassinado.
VERIFY_SSL=1

# ---------------------------------------------------------------------------
# Vetor denso (Fase 2)
# ---------------------------------------------------------------------------
# Offline por padrao, como o BM25: se o modelo faltar no cache, aborta dizendo
# qual artefato falta e como pre-cachea-lo. Nunca baixa em silencio.
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_CACHE_DIR=./models/e5
# O PyTorch com build ROCm expoe a GPU da AMD pela MESMA API "cuda".
# Nao existe device "rocm" nem "hip". Use "cpu" para rodar sem GPU (24x mais lento).
EMBED_DEVICE=cuda
# Medido na RX 6900 XT: a vazao satura em batch 8 e piora acima de 32. Com 16 sao
# 89 fatias/s com 1,87 GiB de pico, contra 67 fatias/s e 13,77 GiB com 256.
EMBED_BATCH_SIZE=16
# NAO defina HIP_VISIBLE_DEVICES. Medido nesta maquina: a ordenacao que o HIP
# aplica a essa variavel NAO e a mesma da enumeracao do torch, e "0" pode cair
# na iGPU do Ryzen (gfx1036, 1 compute unit) mesmo com a discreta presente. O
# codigo escolhe a GPU pelo numero de compute units e recusa a integrada com
# mensagem explicita. Para fixar um indice de proposito, use EMBED_DEVICE=cuda:N.
# NAO defina HSA_OVERRIDE_GFX_VERSION: o rocminfo 7.2.4 ja reporta gfx1030
# nativamente e o override so serve para placa que o ROCm nao reconhece.

# ---------------------------------------------------------------------------
# Reranker cross-encoder (segunda etapa da busca)
# ---------------------------------------------------------------------------
# Reordena os candidatos da primeira etapa lendo consulta e documento JUNTOS.
# Medido: traz o alvo de sinonimo da posicao 8 para 3 e de fora-da-pagina para 5.
# Custa ~475 ms na consulta em prosa; consulta com identificador nao passa por
# ele (o cross-encoder derrubava VENDAS-14993 de 1o para 2o).
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CACHE_DIR=./models/reranker
# Mais candidatos PIORA: 20 e 30 dao o mesmo resultado, 80 derruba o alvo de 3
# para 5 porque mais competicao dilui. E cada candidato custa um forward.
RERANK_CANDIDATES=30
RERANK_BATCH_SIZE=16
# Herda EMBED_DEVICE se nao definido.
#RERANK_DEVICE=cuda

# ---------------------------------------------------------------------------
# Servidor MCP: transporte
# ---------------------------------------------------------------------------
# stdio           = um processo por cliente, alcancado por SSH (chave por pessoa)
# streamable-http = um servico so, alcancado por URL (sem chave, sem identificacao)
MCP_TRANSPORT=streamable-http
# 0.0.0.0 atende a rede. Em producao quem fecha a porta e o proxy reverso, que
# termina o TLS e e a unica coisa que fala com esta porta.
MCP_HOST=0.0.0.0
MCP_PORT=8765
# O endpoint fica na RAIZ, e nao em /mcp: e o endereco que todos os clientes ja
# configurados usam. Mudar isto quebra a configuracao de todo mundo de uma vez.
MCP_PATH=/
# TLS. Vazios = HTTP puro, e e assim que fica em producao: quem termina o
# certificado e o proxy reverso na frente, com Let's Encrypt, e este servico so
# fala HTTP com ele.
#
# Terminar TLS aqui so faz sentido sem proxy na frente. Nao use certificado de
# CA propria: o cliente que nao tem a CA instalada e RECUSADO ("unable to get
# local issuer certificate"), entao isso troca "zero configuracao" por "instale
# uma CA em cada maquina".
#MCP_TLS_CERT=/home/ubuntu/rag/certs/mcp-empresa.crt
#MCP_TLS_KEY=/home/ubuntu/rag/certs/mcp-empresa.key
# O SDK valida o cabecalho Host e recusa o que nao estiver aqui. Vazio = so o
# proprio IP da maquina e o localhost, descobertos no boot -- e por isso todo
# acesso via proxy morre com 421 "Invalid Host header".
#
# Tres pegadinhas, todas ja custaram tempo:
#  - preencher esta lista SOBRESCREVE os defaults: localhost e o IP da maquina
#    tem que ser repetidos aqui, senao param de funcionar;
#  - host SEM porta (o que um proxy em 443 encaminha) NAO casa com "nome:*".
#    Precisa da entrada exata, sem porta;
#  - o SDK valida o cabecalho Origin contra esta MESMA lista, por isso as
#    entradas com esquema (https://...) convivem com as sem esquema.
MCP_ALLOWED_HOSTS=wmw-rag.wmw.com.br,wmw-rag.wmw.com.br:*,https://wmw-rag.wmw.com.br,10.1.1.114:*,http://10.1.1.114:*,localhost:*,http://localhost:*,127.0.0.1:*,http://127.0.0.1:*

# ---------------------------------------------------------------------------
# Painel web de operacao (panel/)
# ---------------------------------------------------------------------------
# O painel mostra logs, acessos e a agenda, e ESCREVE no crontab do usuario ao
# salvar a agenda.
#
# Em 127.0.0.1 (padrao) ele nao pede senha: quem esta na maquina ja pode editar
# o crontab de qualquer jeito. Para acessar de fora sem abrir porta, tunel SSH:
#   ssh -L 8770:127.0.0.1:8770 host
#
# Para ATENDER A REDE (PANEL_HOST=0.0.0.0), PANEL_PASSWORD e OBRIGATORIA: sem
# ela o painel se RECUSA a subir, porque quem alcancasse a porta mudaria o
# horario das rodadas. Mesma regra do escopo vazio que aborta a extracao.
# Autenticacao Basic; sobre HTTP puro ela barra acesso casual e varredura, nao
# quem farejar o trafego.
PANEL_HOST=127.0.0.1
PANEL_PORT=8770
PANEL_USER=admin
PANEL_PASSWORD=
# Assume o risco de expor sem senha. Nao use.
#PANEL_ALLOW_INSECURE=0


# ---------------------------------------------------------------------------
# Autenticacao do MCP: OAuth 2.1 na frente, LDAP como identidade
# ---------------------------------------------------------------------------
# DESLIGADA por padrao. Ligar fecha o servidor: quem chega sem token passa a
# receber 401, e TODO cliente ja configurado precisa reconectar e fazer login.
# Nao e uma transicao suave -- combine o dia antes de virar.
MCP_AUTH_ENABLED=0

# O endereco publico, exatamente como o cliente digita. Vai literal nos
# metadados do OAuth, e a comparacao de issuer e string por string: uma barra
# a mais aqui quebra o login inteiro sem mensagem util.
MCP_PUBLIC_URL=https://wmw-rag.wmw.com.br

# Estado do OAuth (clientes registrados, codigos, tokens). Arquivo SEPARADO do
# document store de proposito: o store viaja entre maquinas nas migracoes e e
# reconstruido por reindexacao, e token nao pode viajar junto nem ser tocado
# por um --reindex-all.
#MCP_AUTH_DB=./data/auth.sqlite3

# Validade dos tokens, em segundos. O access curto e o refresh longo sao o
# padrao: o cliente renova sozinho, e revogar no painel corta em no maximo
# MCP_TOKEN_TTL.
#MCP_TOKEN_TTL=28800
#MCP_REFRESH_TTL=2592000
#MCP_CODE_TTL=300

# O diretorio. NAO existe conta de servico: o bind e feito com a credencial da
# propria pessoa, e nenhuma senha e guardada por este projeto -- nem em hash.
LDAP_URL=ldap://auth.wmw.com.br:3890
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=wmw,dc=com,dc=br
# O grupo separa "e funcionario" de "pode usar esta busca". Sem ele, todo mundo
# com conta na rede entraria.
LDAP_GROUP_DN=cn=wmw-rag,ou=groups,dc=wmw,dc=com,dc=br
LDAP_GROUP_MEMBER_ATTRIBUTE=memberOf
